# Project Terra — Production & Local Environment Variables Template
# Copy to .env and replace secrets before running in production.

PORT=5000

# Explicit comma-separated CORS allow-list (wildcards '*' are rejected).
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173

# 32+ byte random hex string used to sign HMAC-SHA256 session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TERRA_SECRET_KEY=replace-with-a-strong-random-secret

# Path to persistent SQLite database for accounts and saved parcels.
TERRA_DB_PATH=/var/data/terra_app.db

# Set to true when serving over HTTPS (Cloud Run, Render, Railway, etc.).
TERRA_COOKIE_SECURE=true

# 'lax' for unified same-origin deployment; 'none' only for split HTTPS origins.
TERRA_COOKIE_SAMESITE=lax

# Optional: set only when deploying frontend separately (e.g. Vercel -> Cloud Run).
# Leave empty when FastAPI serves frontend/dist directly.
VITE_API_BASE_URL=
